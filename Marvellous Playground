local WindUI = loadstring(game:HttpGet("https://github.com/Footagesus/WindUI/releases/latest/download/main.lua"))()

local selectedChar = nil
local selectedRemote = nil
local spamOn = false
local spamDelay = 0.15

local charsFolder = RS:FindFirstChild("Characters") or RS:WaitForChild("Characters", 10)

local function getCharacters()
	local list = {}
	if not charsFolder then return list end
	for _, ch in ipairs(charsFolder:GetChildren()) do
		table.insert(list, ch.Name)
	end
	table.sort(list)
	return list
end

local function getRemotes(charName)
	local list, seen = {}, {}
	if not charsFolder or not charName then return list end
	local ch = charsFolder:FindFirstChild(charName)
	if not ch then return list end
	local function add(inst)
		if (inst:IsA("RemoteEvent") or inst:IsA("RemoteFunction")) and not seen[inst.Name] then
			seen[inst.Name] = true
			table.insert(list, inst.Name)
		end
	end
	local remotes = ch:FindFirstChild("Remotes")
	if remotes then
		for _, r in ipairs(remotes:GetDescendants()) do add(r) end
		for _, r in ipairs(remotes:GetChildren()) do add(r) end
	end
	for _, r in ipairs(ch:GetDescendants()) do add(r) end
	table.sort(list)
	return list
end

local function findRemote(charName, remoteName)
	if not charsFolder then return nil end
	local ch = charsFolder:FindFirstChild(charName)
	if not ch then return nil end
	local folder = ch:FindFirstChild("Remotes")
	if folder then
		local r = folder:FindFirstChild(remoteName, true)
		if r then return r end
	end
	local r = ch:FindFirstChild(remoteName, true)
	if r and (r:IsA("RemoteEvent") or r:IsA("RemoteFunction")) then return r end
	return nil
end

local function clearClientCD()
	local char = LP.Character
	if not char then return end
	for _, v in ipairs(char:GetDescendants()) do
		local n = string.lower(v.Name)
		if n:find("cooldown") or n:find("debounce") or n:find("cd") or n:find("timer") then
			if v:IsA("NumberValue") or v:IsA("IntValue") then
				pcall(function() v.Value = 0 end)
			elseif v:IsA("BoolValue") then
				pcall(function() v.Value = false end)
			end
		end
		pcall(function()
			if v:GetAttribute("Cooldown") ~= nil then v:SetAttribute("Cooldown", 0) end
			if v:GetAttribute("CD") ~= nil then v:SetAttribute("CD", 0) end
			if v:GetAttribute("OnCooldown") ~= nil then v:SetAttribute("OnCooldown", false) end
		end)
	end
end

RunService.Heartbeat:Connect(function()
	if spamOn then clearClientCD() end
end)

local function fireSelected()
	if not selectedChar or not selectedRemote then return end
	clearClientCD()
	local re = findRemote(selectedChar, selectedRemote)
	if not re then return end
	if re:IsA("RemoteEvent") then
		local ok = pcall(function() re:FireServer(LP) end)
		if not ok then pcall(function() re:FireServer() end) end
	elseif re:IsA("RemoteFunction") then
		pcall(function() re:InvokeServer(LP) end)
	end
end

task.spawn(function()
	while true do
		if spamOn and selectedChar and selectedRemote then
			fireSelected()
			task.wait(spamDelay)
		else
			task.wait(0.1)
		end
	end
end)

